# ====================================================================
# DAGR Cloud & Dashboard Production Environment Configuration
# ====================================================================

# 1. Cryptographic Secret for Session JWTs & OAuth CSRF States (Required in Production)
# Generate with: openssl rand -base64 32
DAGR_AUTH_SECRET=your_32_byte_cryptographic_secret_here

# 2. GitHub OAuth Application Credentials
# Create at: https://github.com/settings/developers
# Callback URL format: https://your-domain.com/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# 3. Google OAuth 2.0 Client Credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 4. Microsoft Entra ID / Azure AD Application
# Create at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Redirect URI: https://your-domain.com/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=your_microsoft_application_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common

# 5. Base App URL (Optional, defaults dynamically to request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000
